# Copia este archivo como .env en la carpeta del proyecto y pon tus valores.
# El archivo .env nunca se sube al repositorio: tiene la clave de la base y los
# nombres reales de los mecánicos.

# PostgreSQL 16 (ADR-001). Sin esta línea se usa el archivo SQLite taller.db.
# DATABASE_URL=postgresql://taller:cambia_esta_clave@localhost:5432/taller

# Nombres de los mecánicos, separados por punto y coma, en el orden 1, 2...
TALLER_MECANICOS=Mecánico 1;Mecánico 2

# Nombre y logo del taller en el encabezado. Guarde el logo en la carpeta marca/
# (no se sube al repositorio). Sin logo se muestra un emblema genérico.
TALLER_NOMBRE=Taller Dos Ruedas
TALLER_LOGO=marca/logo.png

# Opcionales
# TALLER_PUERTO=8000
# TALLER_BD_ARCHIVO=taller.db
