# Copia este archivo como .env y pon tus valores reales. El archivo .env nunca se sube.
# Estas variables las usará la API cuando se conecte la base de datos (ADR-001).

# Conexión a PostgreSQL 16
DATABASE_URL=postgresql://usuario:cambia_esta_clave@localhost:5432/taller

# Clave para firmar los tokens JWT de los trabajadores. Genera una larga y aleatoria.
JWT_SECRET=cambia_este_valor
