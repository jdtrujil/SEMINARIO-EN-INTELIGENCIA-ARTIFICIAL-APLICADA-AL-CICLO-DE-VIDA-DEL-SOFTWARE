# Variables de entorno y secretos: nunca se suben
.env
.env.*
# La plantilla sin valores reales sí se sube
!.env.example

# Entornos virtuales
.venv/
venv/

# Archivos generados por Python y las pruebas
__pycache__/
*.pyc
.pytest_cache/
.coverage
# Bases de datos locales del taller
*.db
# Logo y marca reales del taller: se configuran en cada equipo
marca/
htmlcov/
coverage.xml
